---
const path = Astro.url.pathname
const writingIsCurrent = path === '/' || path.startsWith('/blog/')
const aboutIsCurrent = path.startsWith('/about')
---

<header class="website-header">
  <div class="header-inner">
    <a
      class="website-title"
      href="/"
      aria-label="Observance by Kapil Dube, home"
    >
      <span class="website-title-name">Observance</span>
      <span class="website-title-byline">by Kapil Dube</span>
    </a>
    <nav class="site-navigation" aria-label="Main navigation">
      <a href="/" aria-current={writingIsCurrent ? 'page' : undefined}
        >Writing</a
      >
      <a href="/about/" aria-current={aboutIsCurrent ? 'page' : undefined}
        >About</a
      >
      <a href="/rss.xml">RSS</a>
      <button class="theme-toggle" type="button" data-theme-toggle>
        <span aria-hidden="true" data-theme-toggle-icon>☾</span>
        <span data-theme-toggle-label>Dark</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]'
  )
  const themeLabel = document.querySelector<HTMLElement>(
    '[data-theme-toggle-label]'
  )
  const themeIcon = document.querySelector<HTMLElement>(
    '[data-theme-toggle-icon]'
  )

  const updateThemeToggle = (theme: 'light' | 'dark') => {
    const nextTheme = theme === 'light' ? 'dark' : 'light'

    themeToggle?.setAttribute('aria-label', `Switch to ${nextTheme} theme`)
    themeLabel && (themeLabel.textContent = nextTheme)
    themeIcon && (themeIcon.textContent = nextTheme === 'dark' ? '☾' : '☀')
  }

  const currentTheme =
    document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
  updateThemeToggle(currentTheme)

  themeToggle?.addEventListener('click', () => {
    const nextTheme =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'

    document.documentElement.dataset.theme = nextTheme
    localStorage.setItem('observance-theme', nextTheme)
    updateThemeToggle(nextTheme)
  })
</script>
