---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ShortBio from '../components/ShortBio.astro'
import BlogTeaser from '../components/BlogTeaser.astro'
import { sortPosts } from '../utils/content'

const posts = sortPosts(await getCollection('blog'))
---

<BaseLayout title="Home">
  <ShortBio />
  <section aria-labelledby="latest-posts">
    <h1 id="latest-posts" class="latest-posts-heading">Latest Posts</h1>
    {
      posts.map((post) => (
        <BlogTeaser
          path={`/blog${post.data.path}/`}
          date={post.data.date}
          title={post.data.title}
          excerpt={post.data.excerpt}
        />
      ))
    }
  </section>
</BaseLayout>
