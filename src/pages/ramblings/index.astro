---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import NoteTeaser from '../../components/NoteTeaser.astro'
import { sortPosts } from '../../utils/content'

const notes = sortPosts(await getCollection('ramblings'))
---

<BaseLayout
  title="Ramblings"
  description="Longer, looser, unfiltered — following a thought wherever it goes."
>
  <header class="page-heading">
    <p class="eyebrow">Ramblings</p>
    <h1>Following a thought.</h1>
    <p>
      I often have long, loose and meandering conversations with some really clever people. I always find them valuable! This is where I will post them, with their permission. Think of it as a Podcast, but in written form.
    </p>
  </header>
  {
    notes.length > 0 ? (
      <div class="writing-list">
        {notes.map((note) => (
          <NoteTeaser
            href={`/ramblings${note.data.path}/`}
            date={note.data.date}
            title={note.data.title}
            excerpt={note.data.excerpt}
          />
        ))}
      </div>
    ) : (
      <p>Nothing here yet. Check back soon.</p>
    )
  }
</BaseLayout>
