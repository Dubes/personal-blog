---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogTeaser from '../../components/BlogTeaser.astro'
import { groupPostsByTag, type TagGroup } from '../../utils/content'

export async function getStaticPaths() {
  const groups = groupPostsByTag(await getCollection('blog'))

  return groups.map((group) => ({
    params: { tag: group.slug },
    props: { group },
  }))
}

interface Props {
  group: TagGroup
}

const { group } = Astro.props
---

<BaseLayout
  title={`Posts tagged ${group.label}`}
  description={`Observance posts tagged ${group.label}.`}
>
  <header class="page-heading">
    <p class="eyebrow">Topic</p>
    <h1>{group.label}</h1>
    <p>
      {group.posts.length}
      {group.posts.length === 1 ? 'essay' : 'essays'} in this collection.
    </p>
  </header>
  <div class="writing-list">
    {
      group.posts.map((post) => (
        <BlogTeaser
          path={`/blog${post.data.path}/`}
          date={post.data.date}
          title={post.data.title}
          excerpt={post.data.excerpt}
          tags={post.data.tags}
        />
      ))
    }
  </div>
</BaseLayout>
