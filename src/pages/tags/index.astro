---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { groupPostsByTag } from '../../utils/content'

const tags = groupPostsByTag(await getCollection('blog'))
---

<BaseLayout title="Tags" description="Browse Observance posts by tag.">
  <header class="page-heading">
    <p class="eyebrow">The archive</p>
    <h1>Browse by topic</h1>
    <p>
      Follow a thread through the ideas, experiments, and lessons collected
      here.
    </p>
  </header>
  <ul class="tag-index">
    {
      tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.slug}/`}>{tag.label}</a>
          <span> ({tag.posts.length})</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
