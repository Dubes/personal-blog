{
  "name": "personal-blog",
  "private": true,
  "description": "Kapil Dube's personal blog, built with Astro",
  "version": "0.1.0",
  "author": "Kapil Dube <dube.kapil@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "develop": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.2.9",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dubes/personal-blog"
  },
  "bugs": {
    "url": "https://github.com/Dubes/personal-blog/issues"
  },
  "license": "MIT",
  "packageManager": "yarn@4.1.1"
}
